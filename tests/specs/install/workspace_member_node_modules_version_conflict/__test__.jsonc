// When two workspace members directly depend on different versions of the
// same package, the hoisted linker hoists the higher one to the workspace root
// and gives the lower one a copy of its own that the member declaring it links
// to from its own node_modules.
//
// https://github.com/denoland/deno/pull/34970
{
  "tempDir": true,
  "tests": {
    "hoisted": {
      "steps": [
        {
          "args": "install --node-modules-dir=manual --node-modules-linker=hoisted",
          "output": "[WILDCARD]"
        },
        {
          "args": "run --allow-read check.ts",
          "output": "check.out"
        }
      ]
    }
  }
}
