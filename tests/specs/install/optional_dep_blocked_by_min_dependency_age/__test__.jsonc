{
  "tempDir": true,
  // An optional dependency whose only matching version is newer than the
  // minimum dependency age still fails the install, as in pnpm
  // (ERR_PNPM_NO_MATURE_MATCHING_VERSION): resolution runs before os/cpu
  // filtering, so it can't tell a foreign platform's prebuild from the one
  // this host needs, and skipping the host's would only move the failure to
  // runtime. An optional dependency that doesn't exist is skipped (see
  // optional_dep_missing_version).
  "steps": [
    {
      "args": "install npm:@denotest/napi-optional-platform",
      "output": "install.out",
      "exitCode": 1
    }
  ]
}
