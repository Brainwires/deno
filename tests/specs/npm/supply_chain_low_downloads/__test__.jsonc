{
  // The low-download check on `deno add` (DENEXT.md item 85). The stand-in
  // downloads API (tests/util/server/servers/supply_chain.rs) gives
  // `*unpopular*` 12 weekly downloads, `*modest*` 5000 and
  // `*unknown-downloads*` no count; DENO_NPM_DOWNLOADS_URL points at it,
  // which also makes the test registry count as one whose downloads are
  // checked. By default (`warn`) it only warns; `prompt` asks in a terminal
  // and refuses without one; `required` also refuses unknown counts.
  "tempDir": true,
  "envs": { "DENO_NPM_DOWNLOADS_URL": "http://localhost:4270/" },
  "tests": {
    // the default: a warning with the count and how to allow it, and the
    // package is added (CI scripts adding small packages keep working)
    "warns_by_default": {
      "cwd": "add",
      "args": "add npm:@denotest/unpopular-pkg@1.0.0",
      "output": "warned.out"
    },
    "off": {
      "cwd": "off",
      "args": "add npm:@denotest/unpopular-pkg@1.0.0",
      "output": "added_silently.out"
    },
    // prompt, not a terminal: refused, nothing written
    "prompt_refuses_without_terminal": {
      "steps": [
        {
          "cwd": "prompt",
          "args": "add npm:@denotest/unpopular-pkg@1.0.0",
          "output": "refused.out",
          "exitCode": 1
        },
        {
          "cwd": "prompt",
          "args": "eval console.log(Deno.readTextFileSync('deno.json').trim())",
          "output": "{}\n"
        }
      ]
    },
    // the same from the environment
    "prompt_from_the_environment": {
      "cwd": "add",
      "args": "add npm:@denotest/unpopular-pkg@1.0.0",
      "envs": { "npm_config_low_download_check": "prompt" },
      "output": "refused.out",
      "exitCode": 1
    },
    // above the default threshold of 1000
    "modest_package_added": {
      "cwd": "prompt",
      "args": "add npm:@denotest/modest-downloads@1.0.0",
      "output": "added_silently_modest.out"
    },
    "allowed_by_name_on_the_command_line": {
      "cwd": "prompt",
      "args": "add --allow-low-downloads=npm:@denotest/unpopular-pkg npm:@denotest/unpopular-pkg@1.0.0",
      "output": "added_silently.out"
    },
    // another name on the flag doesn't allow it
    "other_name_on_the_command_line": {
      "cwd": "prompt",
      "args": "add --allow-low-downloads=npm:left-pad npm:@denotest/unpopular-pkg@1.0.0",
      "output": "refused.out",
      "exitCode": 1
    },
    "allowed_all_on_the_command_line": {
      "cwd": "prompt",
      "args": "add --allow-low-downloads npm:@denotest/unpopular-pkg@1.0.0",
      "output": "added_silently.out"
    },
    "allowed_by_npmrc_glob": {
      "cwd": "allowed_npmrc",
      "args": "add npm:@denotest/unpopular-pkg@1.0.0",
      "output": "added_silently.out"
    },
    "allowed_by_deno_json": {
      "cwd": "allowed_deno_json",
      "args": "add npm:@denotest/unpopular-pkg@1.0.0",
      "output": "added_silently.out"
    },
    "threshold_zero_turns_it_off": {
      "cwd": "threshold_off",
      "args": "add npm:@denotest/unpopular-pkg@1.0.0",
      "output": "added_silently.out"
    },
    // a name the lockfile already has is not checked again
    "known_to_the_lockfile": {
      "steps": [
        {
          "cwd": "prompt",
          "args": "add --allow-low-downloads=npm:@denotest/unpopular-pkg npm:@denotest/unpopular-pkg@1.0.0",
          "output": "[WILDCARD]"
        },
        {
          "cwd": "prompt",
          "args": "add npm:@denotest/unpopular-pkg@1.0.0",
          "output": "added_silently.out"
        }
      ]
    },
    // an unknown count lets it through under prompt, and refuses under
    // required
    "unknown_count_is_allowed": {
      "cwd": "prompt",
      "args": "add npm:@denotest/unknown-downloads-pkg@1.0.0",
      "output": "[WILDCARD]Add npm:@denotest/unknown-downloads-pkg@1.0.0[WILDCARD]"
    },
    "unreachable_api_is_allowed": {
      "cwd": "prompt",
      "args": "add npm:@denotest/unpopular-pkg@1.0.0",
      "envs": { "DENO_NPM_DOWNLOADS_URL": "http://localhost:4270/down/" },
      "output": "added_silently.out"
    },
    "required_refuses_unknown_count": {
      "cwd": "required",
      "args": "add npm:@denotest/unknown-downloads-pkg@1.0.0",
      "output": "refused_unknown.out",
      "exitCode": 1
    },
    // a registry other than npmjs.org (here, the test registry without the
    // downloads API override) has no public counts: not checked
    "other_registry_not_checked": {
      "cwd": "prompt",
      "args": "add npm:@denotest/unpopular-pkg@1.0.0",
      "envs": { "DENO_NPM_DOWNLOADS_URL": "" },
      "output": "added_silently.out"
    }
  }
}
