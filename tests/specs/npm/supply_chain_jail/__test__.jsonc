{
  // jail-scripts (DENEXT.md item 83): an approved dependency's lifecycle
  // script runs with a scrubbed environment, a scratch HOME, writes confined
  // to node_modules + temp, no credential files, no network, and every deno
  // it starts clamped to the same. @denotest/jail-probe's postinstall tries
  // the ways out (node, sh, a symlink of its own, a workspace member's link,
  // `deno run -A`, npx, `deno install`) and records what happened.
  "tempDir": true,
  "envs": {
    "GITHUB_TOKEN": "gh-secret",
    "NPM_TOKEN": "npm-secret",
    "npm_config__authToken": "npm-auth-secret",
    "JAIL_PASSED_VAR": "passed"
  },
  "tests": {
    "jailed_linux": {
      "if": "linux",
      "steps": [
        {
          "cwd": "probe",
          "args": "install --allow-scripts=npm:@denotest/jail-probe --jail-scripts",
          "output": "[WILDCARD]"
        },
        {
          "cwd": "probe",
          "args": "run -A check.mjs jail-probe",
          "output": "jailed_linux.out"
        }
      ]
    },
    "jailed_mac": {
      "if": "mac",
      "steps": [
        {
          "cwd": "probe",
          "args": "install --allow-scripts=npm:@denotest/jail-probe --jail-scripts",
          "output": "[WILDCARD]"
        },
        {
          "cwd": "probe",
          "args": "run -A check.mjs jail-probe",
          "output": "jailed_mac.out"
        }
      ]
    },
    // no OS sandbox: a warning; the environment, HOME and every deno the
    // script starts are still confined
    "jailed_windows": {
      "if": "windows",
      "steps": [
        {
          "cwd": "probe",
          "args": "install --allow-scripts=npm:@denotest/jail-probe --jail-scripts",
          "output": "jailed_windows_install.out"
        },
        {
          "cwd": "probe",
          "args": "run -A check.mjs jail-probe",
          "output": "jailed_windows.out"
        }
      ]
    },
    // DENEXT.md item 124 (M7): the jail on by default warns there too
    "jailed_windows_default": {
      "if": "windows",
      "cwd": "control",
      "args": "install --allow-scripts=npm:@denotest/jail-control-probe",
      "output": "jailed_windows_install.out"
    },
    // without jail-scripts (`--no-jail-scripts`, the opt-out of the default,
    // DENEXT.md item 103), the same script sees and writes everything
    "not_jailed": {
      "steps": [
        {
          "cwd": "control",
          "args": "install --allow-scripts=npm:@denotest/jail-control-probe --no-jail-scripts",
          "output": "[WILDCARD]"
        },
        {
          "cwd": "control",
          "args": "run -A check.mjs jail-control-probe",
          "output": "not_jailed.out"
        }
      ]
    },
    // on Linux the probe can read the installer's GITHUB_TOKEN through /proc
    // when it isn't jailed: what `ancestor environ: hidden` above rules out
    "not_jailed_linux": {
      "if": "linux",
      "steps": [
        {
          "cwd": "control",
          "args": "install --allow-scripts=npm:@denotest/jail-control-probe --no-jail-scripts",
          "output": "[WILDCARD]"
        },
        {
          "cwd": "control",
          "args": "run -A check.mjs jail-control-probe",
          "output": "not_jailed_linux.out"
        }
      ]
    },
    // DENEXT.md item 103: jailed without being asked
    "jailed_by_default": {
      "if": "unix",
      "steps": [
        {
          "cwd": "control",
          "args": "install --allow-scripts=npm:@denotest/jail-control-probe",
          "output": "[WILDCARD]"
        },
        {
          "cwd": "control",
          "args": "run -A check.mjs jail-control-probe",
          "output": "jailed_control.out"
        }
      ]
    },
    // the opt-out as an .npmrc key (its environment form) restores the old
    // behavior
    "not_jailed_by_npmrc_key": {
      "steps": [
        {
          "cwd": "control",
          "args": "install --allow-scripts=npm:@denotest/jail-control-probe",
          "envs": { "npm_config_jail_scripts": "false" },
          "output": "[WILDCARD]"
        },
        {
          "cwd": "control",
          "args": "run -A check.mjs jail-control-probe",
          "output": "not_jailed.out"
        }
      ]
    },
    // ... and in deno.json (`"supplyChain": { "jailScripts": false }`)
    "not_jailed_by_deno_json": {
      "steps": [
        {
          "cwd": "optout",
          "args": "install --allow-scripts=npm:@denotest/jail-control-probe",
          "output": "[WILDCARD]"
        },
        {
          "cwd": "optout",
          "args": "run -A check.mjs jail-control-probe",
          "output": "not_jailed.out"
        }
      ]
    },
    // paranoid doesn't take the opt-out
    "paranoid_refuses_no_jail_scripts": {
      "cwd": "paranoid",
      "args": "install --allow-scripts=npm:@denotest/jail-control-probe --no-jail-scripts",
      "output": "paranoid_no_jail_flag.out",
      "exitCode": 1
    },
    // the same with npm_config_jail_scripts (an .npmrc key's environment form)
    "jailed_by_npmrc_key": {
      "if": "unix",
      "steps": [
        {
          "cwd": "control",
          "args": "install --allow-scripts=npm:@denotest/jail-control-probe",
          "envs": { "npm_config_jail_scripts": "true" },
          "output": "[WILDCARD]"
        },
        {
          "cwd": "control",
          "args": "run -A check.mjs jail-control-probe",
          "output": "jailed_control.out"
        }
      ]
    },
    // deno.json's per-package exceptions: an environment variable passed
    // through, and an extra write path (the project's own directory)
    "per_package_exceptions": {
      "if": "unix",
      "steps": [
        {
          "cwd": "exceptions",
          "args": "install --allow-scripts=npm:@denotest/jail-control-probe",
          "output": "[WILDCARD]"
        },
        {
          "cwd": "exceptions",
          "args": "run -A check.mjs jail-control-probe",
          "output": "exceptions.out"
        }
      ]
    },
    // DENEXT.md item 125: a package.json project (no deno.json) keeps its
    // approvals and exceptions in package.json's "deno" object; the same
    // exceptions, and the approval without --allow-scripts
    "per_package_exceptions_package_json": {
      "if": "unix",
      "steps": [
        {
          "cwd": "exceptions_pkg_json",
          "args": "install",
          "output": "[WILDCARD]"
        },
        {
          "cwd": "exceptions_pkg_json",
          "args": "run -A check.mjs jail-control-probe",
          "output": "exceptions.out"
        }
      ]
    },
    // an install check that loads the package's own prebuilt Node-API addon
    // (node-gyp-build-test) may: native code from the package's folder only
    "native_addon_own_folder": {
      "if": "unix",
      "steps": [
        {
          "cwd": "native_addon",
          "args": "install --allow-scripts=npm:@denotest/jail-native-addon --jail-scripts",
          "output": "[WILDCARD]"
        },
        {
          "cwd": "native_addon",
          "args": "run -A check.mjs",
          "output": "native_addon.out"
        }
      ]
    },
    // no OS sandbox to confine what an addon does: no native code at all
    "native_addon_unconfined": {
      "if": "windows",
      "steps": [
        {
          "cwd": "native_addon",
          "args": "install --allow-scripts=npm:@denotest/jail-native-addon --jail-scripts",
          "output": "[WILDCARD]"
        },
        {
          "cwd": "native_addon",
          "args": "run -A check.mjs",
          "output": "native_addon_unconfined.out"
        }
      ]
    },
    // DENEXT.md item 124 (M2): the download host a package declares
    // (node-pre-gyp's binary.host) is a request, not a grant: without the
    // project's say-so it reaches nothing, and the install names the host
    // and the config line that allows it (a package.json "deno" entry here,
    // a project with no deno.json: DENEXT.md item 125)
    "declared_download_host_refused": {
      "if": "unix",
      "steps": [
        {
          "cwd": "net",
          "args": "install --allow-scripts=npm:@denotest/jail-net-declared --jail-scripts",
          "output": "declared_refused.out"
        },
        {
          "cwd": "net",
          "args": "eval console.log(Deno.readTextFileSync('node_modules/@denotest/jail-net-declared/results.txt').trim())",
          "output": "declared host: denied\nother host: denied\n"
        }
      ]
    },
    // (H3) a declared host the project lists in `knownPackages` is honoured
    // as declared: no hint, but `localhost` (or any address on this
    // machine, in any form) is refused by the proxy whatever the
    // declaration says; only the project's own `net` list is exempt
    // (`per_package_net_hosts`)
    "declared_download_host_known_but_internal": {
      "if": "unix",
      "steps": [
        {
          "cwd": "net_known",
          "args": "install --allow-scripts=npm:@denotest/jail-net-declared --jail-scripts",
          "output": "declared_known.out"
        },
        {
          "cwd": "net_known",
          "args": "eval console.log(Deno.readTextFileSync('node_modules/@denotest/jail-net-declared/results.txt').trim())",
          "output": "declared host: denied\nother host: denied\n"
        }
      ]
    },
    // (H1, H2, M4, M6) the ways out of the jail: typing into the terminal
    // (TIOCSTI; the script has its own session and no /dev/tty), a hard
    // link from outside the writable roots, a process left behind (killed
    // with the script's process group), and on macOS the system services
    // (LaunchServices, launchd, the keychain, AppleEvents, the pasteboard)
    "escapes_denied_linux": {
      "if": "linux",
      "steps": [
        {
          "cwd": "escape",
          "args": "install --allow-scripts=npm:@denotest/jail-escape-probe",
          "output": "[WILDCARD]"
        },
        {
          "cwd": "escape",
          "args": "run -A check.mjs",
          "output": "escape_linux.out"
        }
      ]
    },
    "escapes_denied_mac": {
      "if": "mac",
      "steps": [
        {
          "cwd": "escape",
          "args": "install --allow-scripts=npm:@denotest/jail-escape-probe",
          "output": "[WILDCARD]"
        },
        {
          "cwd": "escape",
          "args": "run -A check.mjs",
          "output": "escape_mac.out"
        }
      ]
    },
    // DENEXT.md item 108: a package's `net` as a host list reaches those
    // hosts only, as --allow-net=<hosts>
    "per_package_net_hosts": {
      "if": "unix",
      "steps": [
        {
          "cwd": "net_hosts",
          "args": "install --allow-scripts=npm:@denotest/jail-cache-download",
          "output": "[WILDCARD]"
        },
        {
          "cwd": "net_hosts",
          "args": "eval console.log(Deno.readTextFileSync('node_modules/@denotest/jail-cache-download/results.txt').trim())",
          "output": "listed host: allowed\nother host: denied\ncache: saved\n"
        }
      ]
    },
    // DENEXT.md item 108: a download cache outside node_modules (here
    // PUPPETEER_CACHE_DIR) persists through `write` + `env`, its directory
    // created for the jail when missing
    "download_cache_persists": {
      "if": "unix",
      "steps": [
        {
          "cwd": "download_cache",
          "args": "install --allow-scripts=npm:@denotest/jail-cache-download",
          "envs": { "PUPPETEER_CACHE_DIR": ".cache/puppeteer" },
          "output": "[WILDCARD]"
        },
        {
          "cwd": "download_cache",
          "args": "eval console.log(Deno.readTextFileSync('node_modules/@denotest/jail-cache-download/results.txt').trim())",
          "output": "listed host: allowed\nother host: allowed\ncache: saved\n"
        },
        {
          "cwd": "download_cache",
          "args": "eval console.log(Deno.readTextFileSync('.cache/puppeteer/chrome/browser.txt').trim())",
          "output": "browser\n"
        }
      ]
    },
    // DENEXT.md item 111 (R1), narrowed by item 124 (M2): a declared
    // download host the project hasn't allowed binds every program the
    // script starts to nothing at all: no proxy, no direct connection
    "declared_host_binds_every_program": {
      "if": "unix",
      "steps": [
        {
          "cwd": "net_proxy",
          "args": "install --allow-scripts=npm:@denotest/jail-net-curl",
          "output": "[WILDCARD]"
        },
        {
          "cwd": "net_proxy",
          "args": "eval console.log(Deno.readTextFileSync('node_modules/@denotest/jail-net-curl/results.txt').trim())",
          "output": "proxy 4545: denied\nproxy 4546: denied\ntunnel 4545: denied\ndirect 4545: denied\ndirect 4546: denied\ndirect 127.0.0.1:4546: denied\nnode socket 4546: denied\n"
        }
      ]
    },
    // (R2) deno.json's per-package host list, which replaces the declared
    // host: curl reaches the listed host through the jail's allow-listing
    // proxy (plain and as a CONNECT tunnel), the proxy refuses another
    // host, and the OS refuses any connection around it
    "per_package_hosts_bind_every_program": {
      "if": "unix",
      "steps": [
        {
          "cwd": "net_proxy_hosts",
          "args": "install --allow-scripts=npm:@denotest/jail-net-curl",
          "output": "[WILDCARD]"
        },
        {
          "cwd": "net_proxy_hosts",
          "args": "eval console.log(Deno.readTextFileSync('node_modules/@denotest/jail-net-curl/results.txt').trim())",
          "output": "proxy 4545: denied\nproxy 4546: allowed\ntunnel 4545: denied\ndirect 4545: denied\ndirect 4546: denied\ndirect 127.0.0.1:4546: denied\nnode socket 4546: denied\n"
        }
      ]
    },
    // a listed name that resolves to this machine (here /etc/hosts's
    // ip6-localhost, ::1) is refused by the proxy, plainly and as a tunnel:
    // a package's declared host or a rebinding DNS answer can't reach local
    // services; the address listed as itself still goes through. Linux only:
    // macOS's /etc/hosts names no loopback host but localhost, which is exempt
    "listed_name_resolving_to_loopback_refused": {
      "if": "linux",
      "steps": [
        {
          "cwd": "net_private",
          "args": "install --allow-scripts=npm:@denotest/jail-net-private",
          "output": "[WILDCARD]"
        },
        {
          "cwd": "net_private",
          "args": "eval console.log(Deno.readTextFileSync('node_modules/@denotest/jail-net-private/results.txt').trim())",
          "output": "literal 127.0.0.1:4546: reached\nname to loopback: refused\nname to loopback, tunnel: refused\n"
        }
      ]
    },
    // (R3) a package's `net: false` drops the host it declares and wins over
    // `jailScripts.net: true`
    "package_net_false_wins": {
      "if": "unix",
      "steps": [
        {
          "cwd": "net_false",
          "args": "install --allow-scripts=npm:@denotest/jail-net-curl",
          "output": "[WILDCARD]"
        },
        {
          "cwd": "net_false",
          "args": "eval console.log(Deno.readTextFileSync('node_modules/@denotest/jail-net-curl/results.txt').trim())",
          "output": "proxy 4545: denied\nproxy 4546: denied\ntunnel 4545: denied\ndirect 4545: denied\ndirect 4546: denied\ndirect 127.0.0.1:4546: denied\nnode socket 4546: denied\n"
        }
      ]
    },
    // (R4) a script writes only beneath its own package: not into another
    // package (whose files run later, outside the jail), through the link or
    // the real path, nor elsewhere in node_modules
    "no_writes_into_other_packages": {
      "if": "unix",
      "steps": [
        {
          "cwd": "sibling_write",
          "args": "install --allow-scripts=npm:@denotest/jail-sibling-write",
          "output": "[WILDCARD]"
        },
        {
          "cwd": "sibling_write",
          "args": "eval console.log(Deno.readTextFileSync('node_modules/@denotest/jail-sibling-write/results.txt').trim())",
          "output": "sibling_write.out"
        },
        {
          "cwd": "sibling_write",
          "args": "eval console.log(Deno.readTextFileSync('node_modules/@denotest/jail-net-declared/index.js').includes('pwned'))",
          "output": "false\n"
        }
      ]
    },
    // DENEXT.md item 129: where the OS confines the script, a jailed deno
    // (the `node` shim, `deno run -A`) creates symlinks whose link and target
    // both stay in the package's folder, as electron's postinstall does when
    // it unpacks an app bundle; a link or target outside it is still refused
    "symlinks_within_own_folder": {
      "if": "unix",
      "steps": [
        {
          "cwd": "symlinks",
          "args": "install --allow-scripts=npm:@denotest/jail-symlinks",
          "output": "[WILDCARD]"
        },
        {
          "cwd": "symlinks",
          "args": "eval console.log(Deno.readTextFileSync('node_modules/@denotest/jail-symlinks/results.txt').trim())",
          "output": "symlinks.out"
        },
        {
          "cwd": "symlinks",
          "args": [
            "eval",
            "console.log(Deno.readLinkSync('node_modules/@denotest/jail-symlinks/dist/Electron.app/Contents/Frameworks/Electron Framework.framework/Versions/Current'))"
          ],
          "output": "A\n"
        }
      ]
    },
    // paranoid: jailed without being asked, and a package can't grant itself
    // the network
    "paranoid_jails": {
      "if": "unix",
      "steps": [
        {
          "cwd": "paranoid",
          "args": "install --allow-scripts=npm:@denotest/jail-control-probe",
          "output": "[WILDCARD]"
        },
        {
          "cwd": "paranoid",
          "args": "run -A check.mjs jail-control-probe",
          "output": "jailed_control.out"
        }
      ]
    },
    "paranoid_ignores_declared_host": {
      "if": "unix",
      "steps": [
        {
          "cwd": "net",
          "args": "install --allow-scripts=npm:@denotest/jail-net-declared",
          "envs": { "npm_config_paranoid": "true" },
          "output": "[WILDCARD]"
        },
        {
          "cwd": "net",
          "args": "eval console.log(Deno.readTextFileSync('node_modules/@denotest/jail-net-declared/results.txt').trim())",
          "output": "declared host: denied\nother host: denied\n"
        }
      ]
    },
    // where nothing can confine the script's other programs, paranoid
    // refuses to run it
    "paranoid_refuses_without_os_sandbox": {
      "if": "windows",
      "cwd": "paranoid",
      "args": "install --allow-scripts=npm:@denotest/jail-control-probe",
      "output": "paranoid_windows.out",
      "exitCode": 1
    }
  }
}
