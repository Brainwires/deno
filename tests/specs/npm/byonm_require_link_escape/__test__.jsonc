{
  // A bring-your-own-node_modules project (nodeModulesDir "manual") lets
  // require() read inside node_modules without --allow-read, but a link in
  // node_modules that leads out of it (node_modules/evil -> ../outside) must
  // not carry that exemption to the files it reaches: require(),
  // createRequire, require.resolve and a chain of links are refused there as
  // an ES module import is. A pnpm-style link into node_modules/.pnpm stays
  // readable. Each script is the main module, so it needs no grant itself.
  "tempDir": true,
  "steps": [
    {
      "args": "run -A setup.js",
      "output": ""
    },
    {
      "args": "run require.cjs",
      "output": "relative: NotCapable\nabsolute: NotCapable\n"
    },
    {
      "args": "run create_require.mjs",
      "output": "createRequire: NotCapable\n"
    },
    {
      "args": "run resolve.cjs",
      "output": "require.resolve: NotCapable\n"
    },
    {
      "args": "run chain.cjs",
      "output": "chain: NotCapable\n"
    },
    {
      "args": "run pnpm.cjs",
      "output": "pnpm: pkg\n"
    },
    {
      // --deny-read applies to what the link reaches. Unix only: a relative
      // --deny-read resolves against the cwd as spelled, which on the Windows
      // runner is an 8.3 short name (RUNNER~1), while the link target is
      // checked by its canonical path.
      "if": "unix",
      "args": "run --allow-read --deny-read=outside require.cjs",
      "output": "relative: NotCapable\nabsolute: NotCapable\n"
    },
    {
      // The node_modules exemption itself (DENEXT.md item 435): a file whose
      // real path is in a node_modules directory, absolute or through a link
      "args": "run deny.cjs",
      "output": "absolute: other\nlink: other\n"
    },
    {
      // ... is exempt from the allow scopes, never from --deny-read on its
      // real path or its spelling (DENEXT.md item 435). Unix only, as above.
      "if": "unix",
      "args": "run --deny-read=other deny.cjs",
      "output": "absolute: NotCapable\nlink: NotCapable\n"
    },
    {
      // a deny scope that is itself a link covers its target too (DENEXT.md
      // item 436): the spelling through the link and the real path alike
      "if": "unix",
      "args": "run --deny-read=node_modules/far deny.cjs",
      "output": "absolute: NotCapable\nlink: NotCapable\n"
    },
    {
      "if": "unix",
      "args": "run --deny-read=other deny.mjs",
      "output": "json import: TypeError: Requires read access to \"[WILDCARD]/other/node_modules/x/s.json\"\n"
    },
    {
      // The main module through a link (lib -> outside) resolves to its real
      // path (DENEXT.md item 395), so it runs exactly as naming
      // outside/mod.cjs does: the main module needs no read grant, and
      // --deny-read=outside refuses both or neither.
      "if": "unix",
      "args": "run --deny-read=outside lib/mod.cjs",
      "output": "outside/mod.cjs ran\n"
    },
    {
      "if": "unix",
      "args": "run --deny-read=outside outside/mod.cjs",
      "output": "outside/mod.cjs ran\n"
    }
  ]
}
