{
  // Each variant in its own copy: the native type check writes the project's
  // generated `.deno/tsconfig.json` from the config it was given, and the two
  // configs here would race over one directory.
  "tempDir": true,
  "tests": {
    "types_included": {
      "args": "publish --dry-run",
      "output": "publish.out"
    },
    "types_missing": {
      "args": "publish --dry-run --config=deno_no_types.json",
      "output": "publish_no_types.out",
      "exitCode": 1
    }
  }
}
