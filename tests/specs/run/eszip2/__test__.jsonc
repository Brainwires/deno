{
  "tempDir": true,
  "steps": [
    {
      "args": "compile --eszip-internal-do-not-use --import-map ./src/import_map.json ./src/a.js",
      "exitCode": 0,
      "output": "[WILDCARD]"
    },
    {
      // denext: auto leaves an eszip run at warn, with a notice (plan
      // denext30 §8); this test is about the eszip itself
      "args": "run --kernel-sandbox=off --eszip-internal-do-not-use --import-map import_map.json a.js#a.eszip",
      "exitCode": 0,
      "output": "./a.out"
    }
  ]
}
