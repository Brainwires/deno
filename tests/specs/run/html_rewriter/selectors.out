* -> main(app) h1(title big) ul(list) li li(odd) li p a(https://deno.com/docs) p a(/local.html) div span em span
h1 -> h1(title big)
.big -> h1(title big)
#app -> main(app)
[lang] -> li
[lang|=en] -> li
[rel~="noopener"] -> a(https://deno.com/docs)
[href^="https:"] -> a(https://deno.com/docs)
[href$=".html"] -> a(/local.html)
[href*="deno"] -> a(https://deno.com/docs)
ul li -> li li(odd) li
div > span -> span
li:first-child -> li
li:nth-child(2) -> li(odd)
li:not(.odd) -> li li
p:nth-of-type(2) a -> a(/local.html)
ul,li,li,li.odd,li
true
