{
  // An unresolvable dynamic import is a runtime error for the in-process
  // checker; the native compiler reports it while type checking (TS2307,
  // with Deno's resolution message).
  "tests": {
    "tsc": {
      "args": "run --check-engine=tsc --reload --check error_012_bad_dynamic_import_specifier.ts",
      "output": "error_012_bad_dynamic_import_specifier.ts.out",
      "exitCode": 1
    },
    "native": {
      "args": "run --reload --check error_012_bad_dynamic_import_specifier.ts",
      "output": "error_012_bad_dynamic_import_specifier_native.out",
      "exitCode": 1
    }
  }
}
