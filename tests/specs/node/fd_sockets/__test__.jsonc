{
  "tempDir": true,
  "tests": {
    "socket_activation": {
      "if": "unix",
      "args": "run --allow-net --allow-run --allow-env --allow-read socket_activation.mjs",
      "output": "socket_activation.out"
    },
    "pipe_fd": {
      "if": "unix",
      "args": "run --allow-read=. --allow-write=. --allow-env --allow-run=mkfifo pipe_fd.mjs",
      "output": "pipe_fd.out"
    },
    "worker_pipe_fd": {
      "if": "unix",
      "args": "run --allow-read --allow-write --allow-env --allow-run=mkfifo worker_pipe_fd.mjs",
      "output": "worker_pipe_fd.out"
    },
    "worker_pipe_fd_all": {
      "if": "unix",
      "args": "run -A worker_pipe_fd.mjs",
      "output": "worker_pipe_fd.out"
    },
    "worker_pipe_fd_scoped": {
      "if": "unix",
      "args": "run --allow-read=. --allow-write=. --allow-env --allow-run=mkfifo worker_pipe_fd.mjs",
      "output": "worker_pipe_fd_scoped.out"
    },
    "inherited_fd_permissions": {
      "if": "unix",
      "args": "run -A inherited_fd_permissions.mjs",
      "output": "inherited_fd_permissions.out"
    },
    "pty_fd": {
      "if": "unix",
      "args": "run --allow-run --allow-read pty_fd.ts --allow-read --allow-write",
      "output": "pty_fd.out"
    },
    "pty_fd_no_permissions": {
      "if": "unix",
      "args": "run --allow-run --allow-read pty_fd.ts --no-prompt",
      "output": "pty_fd_no_permissions.out"
    },
    "long_unix_path": {
      "if": "mac",
      "args": "run -A long_unix_path.mjs",
      "output": "long_unix_path.out"
    },
    "windows_refuse": {
      "if": "windows",
      "args": "run -A windows_refuse.mjs",
      "output": "windows_refuse.out"
    }
  }
}
