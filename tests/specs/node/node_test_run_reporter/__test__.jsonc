{
  // Outside `deno test`, `node:test` runs the tests itself and reports them as
  // Node's runner does: `spec` by default, `tap`, `dot` or `junit` by
  // `--test-reporter` (which the node shim forwards in NODE_OPTIONS). A failed
  // test makes the exit code 1.
  "tests": {
    "spec": {
      "args": "run -A main.cjs",
      "output": "spec.out",
      "exitCode": 1
    },
    "tap": {
      "args": "run -A main.cjs",
      "envs": { "NODE_OPTIONS": "--test-reporter=tap" },
      "output": "tap.out",
      "exitCode": 1
    },
    "dot": {
      "args": "run -A main.cjs",
      "envs": { "NODE_OPTIONS": "--test-reporter=dot" },
      "output": "dot.out",
      "exitCode": 1
    },
    "junit": {
      "args": "run -A main.cjs",
      "envs": { "NODE_OPTIONS": "--test-reporter=junit" },
      "output": "junit.out",
      "exitCode": 1
    },
    // `--test-random-seed` orders the root's, a suite's and a test's subtests
    // as Node 26 does (`random_tap.out` is Node's output for the seed); the
    // numbers stay the declaration order.
    "random_seed": {
      "args": "run -A random.cjs",
      "envs": {
        "NODE_OPTIONS": "--test-reporter=tap --test-random-seed=12345"
      },
      "output": "random_tap.out",
      "exitCode": 0
    },
    "unawaited_subtest": {
      "args": "run -A unawaited.cjs",
      "output": "unawaited.out",
      "exitCode": 0
    }
  }
}
