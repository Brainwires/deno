{
  // `node --test` runs each test file in its own process, as Node's runner:
  // the default patterns find `test/**/*` and `*.test.js`, never
  // `node_modules`; a file with no tests is a test of its own; the top-level
  // tests are numbered across the files, in file order.
  "tests": {
    "default_patterns_tap": {
      "cwd": "project",
      "args": "run -A ../node.mjs --test --test-reporter=tap",
      "output": "tap.out",
      "exitCode": 1
    },
    "default_patterns_spec": {
      "cwd": "project",
      "args": "run -A ../node.mjs --test",
      "output": "spec.out",
      "exitCode": 1
    },
    "named_file_passes": {
      "cwd": "project",
      "args": "run -A ../node.mjs --test --test-reporter=dot test/a.js",
      "output": "dot.out"
    },
    "isolation_none": {
      "cwd": "project",
      "args": "run -A ../node.mjs --test --test-isolation=none --test-reporter=tap test/a.js test/empty.js",
      "output": "none.out"
    },
    "missing_file": {
      "cwd": "project",
      "args": "run -A ../node.mjs --test does-not-exist.js",
      "output": "missing.out",
      "exitCode": 1
    },
    "custom_reporter": {
      "cwd": "project",
      "args": "run -A ../node.mjs --test --test-reporter=./reporter.mjs test/a.js",
      "output": "custom.out"
    },
    "run_api": {
      "cwd": "project",
      "args": "run -A run_api.mjs",
      "output": "run_api.out"
    },
    // `--experimental-test-coverage`: Node's table and `lcov`, from each
    // file's V8 coverage.
    "coverage_table": {
      "cwd": "cov",
      "args": "run -A ../node.mjs --test --experimental-test-coverage --test-reporter=tap",
      "output": "cov_table.out"
    },
    "coverage_lcov": {
      "cwd": "cov",
      "args": "run -A ../node.mjs --test --experimental-test-coverage --test-reporter=lcov",
      "output": "cov_lcov.out"
    },
    "coverage_threshold": {
      "cwd": "cov",
      "args": "run -A ../node.mjs --test --experimental-test-coverage --test-reporter=dot --test-coverage-lines=100",
      "output": "cov_threshold.out",
      "exitCode": 1
    },
    "coverage_single_file": {
      "cwd": "cov",
      "args": "run -A ../node.mjs --experimental-test-coverage --test-reporter=tap math.test.js",
      "output": "cov_table.out"
    },
    // A `.ts` file's coverage, mapped from the emitted code back to the
    // file's lines through the map its process writes beside it: what Node
    // reports for the same files (which strips types in place).
    "coverage_ts_source_map": {
      "cwd": "cov_ts",
      "args": "run -A ../node.mjs --test --experimental-test-coverage --test-reporter=lcov",
      "output": "cov_ts.out"
    },
    // A file of `Deno.test()` tests fails under `node --test` (its tests
    // would not run), as it does in Node (`Deno` is not defined there);
    // outside the runner `Deno.test()` still registers nothing, and
    // `deno test` runs the file.
    "deno_test_file_fails": {
      "cwd": "deno_test",
      "args": "run -A ../node.mjs --test --test-reporter=tap math.test.js",
      "output": "deno_test_tap.out",
      "exitCode": 1
    },
    "deno_test_outside_runner": {
      "cwd": "deno_test",
      "args": "run -A math.test.js",
      "output": ""
    },
    "deno_test_under_deno_test": {
      "cwd": "deno_test",
      "args": "test -A math.test.js",
      "output": "deno_test_deno.out"
    },
    // A reporter that fails ends the run with exit code 7, as in Node (the
    // runner's uncaught exception handler rethrows a reporter's error).
    "reporter_error_exit_code": {
      "cwd": "r6",
      "args": "run -A ../node.mjs --test --test-reporter=./throwing_reporter.mjs test/pass.js",
      "output": "r6/reporter_error.out",
      "exitCode": 7
    },
    "reporter_setup_error_exit_code": {
      "cwd": "r6",
      "args": "run -A ../node.mjs --test --test-reporter=./no_reporter.mjs test/pass.js",
      "output": "r6/reporter_setup_error.out",
      "exitCode": 7
    },
    // Test tags on the events of each test (its parents' then its own), and
    // `testTagFilters` keeping the tests that have every tag given.
    "tags_in_events": {
      "cwd": "r6",
      "args": "run -A tags_events.mjs",
      "output": "r6/tags.out"
    },
    // `--test-rerun-failures`: what passed in an earlier attempt is replayed,
    // and each attempt's passes are added to the file.
    "rerun_failures": {
      "cwd": "r6",
      "args": "run -A rerun_driver.mjs",
      "output": "r6/rerun.out"
    },
    // A failure's stack: `node:internal/` frames and a CommonJS file's path.
    "failure_stack_frames": {
      "cwd": "r6",
      "args": "run -A stack_driver.mjs",
      "output": "r6/stack.out"
    },
    "loader_in_node_options": {
      "cwd": "project",
      "args": "run -A loader_main.mjs",
      "envs": { "NODE_OPTIONS": "--experimental-loader ./loader.mjs" },
      "output": "virtual\n"
    }
  }
}
