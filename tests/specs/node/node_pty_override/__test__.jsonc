{
  // node-pty is a native addon Deno does not build: a package without the
  // addon for the platform has its entry module resolve to an implementation
  // of its API over Deno.openPty (one that carries the addon loads it, as on
  // Node: `addon_present_loads_the_package`, and spec compile/node_pty_addon
  // with a real addon). The package here is a stand-in whose own code would
  // throw, as the real one's addon load does. Unix only: the shell these
  // drive is `sh`. On Windows the runtime's pty is not available yet
  // (DENEXT.md item 259): `windows_not_supported` checks that spawn says so.
  "tempDir": true,
  "tests": {
    "addon_present_loads_the_package": {
      "steps": [{
        "args": "run -A addon_present_setup.mjs",
        "output": "[WILDCARD]"
      }, {
        "args": "run -A main.cjs",
        // the stand-in's own entry ran (the same throw as the opt-out's)
        "output": "opt_out.out",
        "exitCode": 1
      }]
    },
    "require": {
      "if": "unix",
      "args": "run -A main.cjs",
      "output": "main.out"
    },
    "import": {
      "if": "unix",
      "args": "run -A esm.mjs",
      "output": "esm.out"
    },
    "signal_and_pause": {
      "if": "unix",
      "args": "run -A signal.cjs",
      "output": "signal.out"
    },
    "destroy_closes_the_terminal": {
      "if": "unix",
      "args": "run -A destroy.cjs",
      "output": "destroy.out"
    },
    "needs_run_permission": {
      "if": "unix",
      "args": "run --allow-read --allow-env esm.mjs",
      // a dynamic-loader variable in the environment needs full run
      // permission first (the `LD_*` rule), which is not what this checks
      "envs": { "LD_LIBRARY_PATH": "", "DYLD_FALLBACK_LIBRARY_PATH": "" },
      "output": "no_run.out",
      "exitCode": 1
    },
    "windows_not_supported": {
      "if": "windows",
      "args": "run -A windows.cjs",
      "output": "windows.out"
    },
    "opt_out": {
      "if": "unix",
      "args": "run -A esm.mjs",
      "envs": { "DENO_NO_NODE_PTY_COMPAT": "1" },
      "output": "opt_out.out",
      "exitCode": 1
    }
  }
}
