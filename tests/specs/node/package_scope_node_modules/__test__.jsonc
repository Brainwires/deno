{
  // A folder under node_modules with no package.json belongs to no package:
  // the project's "type": "module" doesn't make its .js files ES modules
  // (Node's package scope lookup stops at node_modules).
  "tests": {
    "require": {
      "args": "run -R main.cjs",
      "output": "loose dep\n"
    },
    "import": {
      "args": "run -R main.js",
      "output": "loose dep\n"
    }
  }
}
