{
  // An async fs / dns call made in a timer callback never completes before
  // another timer that is due in the same timers phase. The calls fail
  // without reaching a thread (a denied path or host, a closed descriptor),
  // which is when their results used to be delivered early.
  "args": "run --no-prompt --allow-read --allow-write --allow-net --deny-read=denied.txt --deny-write=denied.txt --deny-net=denied.invalid,127.0.0.1 main.cjs",
  "output": "main.out"
}
