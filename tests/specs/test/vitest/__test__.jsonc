{
  // The Vitest compatibility layer: Vitest suites run unchanged under
  // `deno test` (see cli/tools/test/vitest).
  "tests": {
    "api": {
      "args": "test -A --no-check api_test.ts",
      "output": "api.out",
      "exitCode": 0
    },
    "expect": {
      "args": "test -A --no-check expect_test.ts",
      "output": "expect.out",
      "exitCode": 0
    },
    "vi": {
      "args": "test -A --no-check vi_test.ts",
      "output": "vi.out",
      "exitCode": 0
    },
    "failures": {
      "args": "test -A --no-check failures_test.ts",
      "output": "failures.out",
      "exitCode": 1
    },
    "hook_error": {
      "args": "test -A --no-check hook_error_test.ts",
      "output": "hook_error.out",
      "exitCode": 1
    },
    "mock_factory": {
      "args": "test -A --no-check mocking/vi_mock_test.ts",
      "output": "mocking/vi_mock.out",
      "exitCode": 0
    },
    "mock_partial": {
      "args": "test -A --no-check mocking/partial_test.ts",
      "output": "mocking/partial.out",
      "exitCode": 0
    },
    "mock_automock": {
      "args": "test -A --no-check mocking/automock_test.ts",
      "output": "mocking/automock.out",
      "exitCode": 0
    },
    "mock_dynamic": {
      "args": "test -A --no-check mocking/dynamic_test.ts",
      "output": "mocking/dynamic.out",
      "exitCode": 0
    },
    "mock_spy_namespace": {
      "args": "test -A --no-check mocking/spy_namespace_test.ts",
      "output": "mocking/spy_namespace.out",
      "exitCode": 0
    },
    "mock_spy_mocked": {
      "args": "test -A --no-check mocking/spy_mocked_test.ts",
      "output": "mocking/spy_mocked.out",
      "exitCode": 0
    },
    "mock_jest": {
      "args": "test -A --no-check mocking/jest_mock_test.ts",
      "output": "mocking/jest_mock.out",
      "exitCode": 0
    },
    "mock_isolated_per_file": {
      "args": "test -A --no-check mocking/isolation_a_test.ts mocking/isolation_b_test.ts",
      "output": "mocking/isolation.out",
      "exitCode": 0
    },
    "mock_nested_error": {
      "args": "test -A --no-check mocking/nested_error_test.ts",
      "output": "mocking/nested_error.out",
      "exitCode": 1
    },
    "mock_factory_error": {
      "args": "test -A --no-check mocking/factory_error_test.ts",
      "output": "mocking/factory_error.out",
      "exitCode": 1
    },
    "mock_config_project": {
      "cwd": "mocking_project",
      "args": "test -A --no-check",
      "output": "mocking_project.out",
      "exitCode": 0
    },
    "coverage": {
      // deno coverage reports the modules the Vitest transform changed: a
      // module mocked in some test files and real in others, a JavaScript
      // one, one that mocks its own import (hoisted), one with only types
      "tempDir": true,
      "steps": [
        {
          "cwd": "coverage",
          "args": "test -A --no-check --coverage=cov",
          "output": "[WILDCARD]ok | 4 passed | 0 failed[WILDCARD]"
        },
        {
          "cwd": "coverage",
          "args": "coverage cov --lcov",
          "output": "coverage/expected_lcov.out"
        }
      ]
    },
    "coverage_mixed": {
      // a module run by a plain Deno test and by Vitest tests: its plain emit
      // and the one the Vitest transform changed are cached apart, and `deno
      // coverage` merges their profiles line by line in terms of the original
      // source, so the merged coverage is the union of the two runs' (a
      // module mocked in one run and real in the other included). The runs
      // keep the directory's profiles with `--coverage-raw-data-only`, which
      // `deno test --coverage` otherwise empties first (as upstream).
      "tempDir": true,
      "steps": [
        {
          "cwd": "coverage_mixed",
          "args": "test -A --no-check --coverage=cov --coverage-raw-data-only plain_test.ts",
          "output": "[WILDCARD]ok | 1 passed | 0 failed[WILDCARD]"
        },
        {
          "cwd": "coverage_mixed",
          "args": "test -A --no-check --coverage=cov --coverage-raw-data-only vitest_test.ts mock_test.ts",
          "output": "[WILDCARD]ok | 2 passed | 0 failed[WILDCARD]"
        },
        {
          "cwd": "coverage_mixed",
          "args": "coverage cov --lcov",
          "output": "coverage_mixed/expected_lcov.out"
        },
        // the other order, with an emit cache of its own: the Vitest run
        // first, then the plain one, which must not make the Vitest run's
        // profiles unreadable
        {
          "cwd": "coverage_mixed",
          "envs": { "DENO_DIR": "$PWD/deno_dir2" },
          "args": "test -A --no-check --coverage=cov2 --coverage-raw-data-only vitest_test.ts mock_test.ts",
          "output": "[WILDCARD]ok | 2 passed | 0 failed[WILDCARD]"
        },
        {
          "cwd": "coverage_mixed",
          "envs": { "DENO_DIR": "$PWD/deno_dir2" },
          "args": "test -A --no-check --coverage=cov2 --coverage-raw-data-only plain_test.ts",
          "output": "[WILDCARD]ok | 1 passed | 0 failed[WILDCARD]"
        },
        {
          "cwd": "coverage_mixed",
          "envs": { "DENO_DIR": "$PWD/deno_dir2" },
          "args": "coverage cov2 --lcov",
          "output": "coverage_mixed/expected_lcov.out"
        }
      ]
    },
    "path_chars": {
      // mocks under a path Node's pathToFileURL spells otherwise than the
      // module loader (`~`, as in a Windows 8.3 short path), and under one a
      // stack trace spells otherwise than the module's URL (a space)
      "cwd": "path_chars",
      "args": "test -A --no-check",
      "output": "[WILDCARD]ok | 2 passed | 0 failed[WILDCARD]",
      "exitCode": 0
    },
    "no_permissions": {
      // Vitest's own runtime needs no permission (its environment reads
      // included); the test's own reads stay checked
      "args": "test --no-check no_permissions/no_permissions_test.ts",
      "output": "no_permissions/no_permissions.out",
      "exitCode": 0
    },
    "no_permissions_file_snapshot": {
      // an unreadable snapshot file fails the run, rather than passing
      // against no snapshot (outside CI mode, where a missing snapshot is
      // written rather than a mismatch: CI runners set CI)
      "envs": { "CI": "false" },
      "args": "test --no-check no_permissions/file_snapshot_test.ts",
      "output": "no_permissions/file_snapshot.out",
      "exitCode": 1
    },
    "jest_globals": {
      "args": "test -A --no-check jest_globals_test.ts",
      "output": "jest_globals.out",
      "exitCode": 0
    },
    "npm_specifier": {
      "args": "test -A --no-check npm_specifier_test.ts",
      "output": "npm_specifier.out",
      "exitCode": 0
    },
    "plain_deno_test_untouched": {
      "args": "test -A --no-check plain_deno_test.ts",
      "output": "plain_deno.out",
      "exitCode": 0
    },
    "filter": {
      "args": "test -A --no-check --filter=square api_test.ts",
      "output": "filter.out",
      "exitCode": 0
    },
    "no_vitest_compat": {
      "args": "test -A --no-check --no-vitest-compat api_test.ts",
      "output": "no_compat.out",
      "exitCode": 1
    },
    "type_check_with_fallback_types": {
      "args": "test -A typed_test.ts",
      "output": "typed.out",
      "exitCode": 0
    },
    "config": {
      "cwd": "config_project",
      "args": "test -A --no-check",
      "output": "config.out",
      "exitCode": 1
    },
    "projects": {
      "cwd": "projects",
      "args": "test -A --no-check",
      "output": "projects.out",
      "exitCode": 0
    },
    // The runner's own reads need no --allow-read within the project (see
    // cli/tools/test/vitest/runner_reads.rs): the config, its imports, its
    // tsconfig and .env files, setup files, `__mocks__` lookups and
    // automocks. The test's (and the config's) own reads stay checked.
    "runner_reads": {
      "cwd": "runner_reads/project",
      "args": "test --no-check",
      "output": "runner_reads/project.out",
      "exitCode": 0
    },
    "runner_reads_symlink_escape": {
      // a symlink out of the project is not followed
      "if": "unix",
      "tempDir": true,
      "steps": [
        {
          "args": "run -A runner_reads/make_link.ts",
          "output": ""
        },
        {
          "cwd": "runner_reads/project",
          "args": "test --no-check src/symlink_escape.spec.ts",
          "output": "runner_reads/symlink_escape.out",
          "exitCode": 0
        }
      ]
    },
    "runner_reads_config_project": {
      "cwd": "config_project",
      "args": "test --no-check",
      "output": "config.out",
      "exitCode": 1
    },
    "runner_reads_mocking_project": {
      "cwd": "mocking_project",
      "args": "test --no-check",
      "output": "mocking_project.out",
      "exitCode": 0
    },
    "runner_reads_projects": {
      "cwd": "projects",
      "args": "test --no-check",
      "output": "projects.out",
      "exitCode": 0
    },
    "projects_selected": {
      "cwd": "projects",
      "args": "test -A --no-check --vitest-project=beta",
      "output": "projects_beta.out",
      "exitCode": 0
    },
    "projects_unknown": {
      "cwd": "projects",
      "args": "test -A --no-check --vitest-project=nope",
      "output": "projects_nope.out",
      "exitCode": 1
    }
  }
}
