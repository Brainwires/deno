{
  // The kernel-sandbox escape corpus (README.md). Without kernel enforcement
  // every probe must come back open (or n/a / host-blocked): the corpus runs,
  // and it says so. Needs a C compiler (`cc`).
  "tests": {
    "corpus_runs_all_open": {
      "if": "unix",
      "args": "run -A --quiet corpus.ts",
      "output": "[WILDCARD]kernel-sandbox corpus: [WILDCARD]\ncorpus: ok [WILDCARD]"
    },
    // --kernel-sandbox=enforce: every kernel cell held, the network none /
    // all and exec decided by the configuration, the rest as documented
    // (expect.ts). Reported as ignored where no enforcer or Landlock exists;
    // on a Linux or macOS CI leg a missing enforcer fails (../../mod.rs).
    "corpus_enforce": {
      "if": "kernelSandboxEnforce",
      "args": "run -A --quiet corpus.ts --expect=enforce",
      "output": "[WILDCARD]kernel-sandbox corpus: [WILDCARD]\ncorpus: ok [WILDCARD]"
    },
    // Who refused a probe: our sandbox (held) or the host (host).
    "classify_unit": {
      "args": "test --quiet --no-check=remote classify_test.ts",
      "output": "[WILDCARD]ok | 7 passed | 0 failed[WILDCARD]"
    }
  }
}
