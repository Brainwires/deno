// denext (DENEXT.md item 466): --kernel-sandbox=broker, the supervising
// broker (Mode B). The program runs confined in a child of the supervisor;
// what the kernel can't hold to Deno's rule exactly, the broker does.
// Linux: a write deny inside a write allow. The kernel refuses changes
// directly in the folders that lead to the deny (native code and children
// get that view); Deno's own operations there go through the broker, which
// holds the deny exactly. macOS holds the deny in the kernel; the supervisor
// and its broker run all the same.
{
  "tempDir": true,
  "tests": {
    "write_deny_is_exact": {
      "if": "kernelSandboxEnforce",
      "steps": [
        { "args": "run --quiet -A setup.ts", "output": "" },
        {
          "args": "run --quiet --kernel-sandbox=broker --allow-ffi --allow-read=. --allow-write=out --deny-write=out/keep write_deny.ts",
          "output": "write_deny.out"
        }
      ]
    },
    // enforce takes the broker by itself where it closes a gap (Linux: the
    // write deny); on macOS enforce holds it alone
    "enforce_chooses_the_broker": {
      "if": "kernelSandboxEnforce",
      "steps": [
        { "args": "run --quiet -A setup.ts", "output": "" },
        {
          "args": "run --quiet --kernel-sandbox=enforce --allow-ffi --allow-read=. --allow-write=out --deny-write=out/keep write_deny.ts",
          "output": "write_deny.out"
        }
      ]
    },
    // the supervisor exits as the program exits
    "exit_code": {
      "if": "kernelSandboxEnforce",
      "args": "run --quiet --kernel-sandbox=broker --allow-write=out exit.ts",
      "output": "leaving\n",
      "exitCode": 7
    },
    // the report names the shape and the broker's part
    "report": {
      "if": "kernelSandboxEnforceLinux",
      "steps": [
        { "args": "run --quiet -A setup.ts", "output": "" },
        {
          "args": "run --kernel-sandbox=broker --kernel-sandbox-report --allow-read=. --allow-write=out --deny-write=out/keep exit0.ts",
          "output": "report.out"
        }
      ]
    },
    // a host-scoped network grant: every socket of the program is made by
    // the broker (names resolved there, the address checked is the address
    // connected), another spelling of an address and a UDP socket are
    // refused by it, and native code has no socket that reaches an address
    "host_scoped_network": {
      "if": "kernelSandboxEnforce",
      "args": "run --quiet -A --unstable-net net_outer.ts",
      "output": "net.out"
    },
    // denext.30: `auto` takes the broker by itself. At the stage where it
    // enforces a run with no terminal (r4), a host-scoped grant starts
    // under the supervisor instead of falling back to warn: the same
    // program, the same answers, and no mode written anywhere. net.out's
    // "another spelling of an address" row is the internal-address rule
    // (plan D6) under `auto`: the grant names `2130706433`, a name to
    // Deno's checks; the broker resolves it to 127.0.0.1, an address on
    // this machine that the grant doesn't name, and refuses
    "auto_host_scoped": {
      "if": "kernelSandboxEnforce",
      "steps": [
        {
          "envs": { "DENO_INTERNAL_KERNEL_SANDBOX_STAGE": "r4" },
          "args": "run --kernel-sandbox-report --allow-net=example.com:443 exit0.ts",
          "output": "auto_report.out"
        },
        {
          "envs": { "BROKER_SPEC_AUTO": "1" },
          "args": "run --quiet -A --unstable-net net_outer.ts",
          "output": "net.out"
        }
      ]
    },
    // ... and a write deny inside a write allow is held exactly (Linux:
    // through the broker; macOS holds it in the kernel, with no supervisor)
    "auto_write_deny_inside_allow": {
      "if": "kernelSandboxEnforce",
      "envs": { "DENO_INTERNAL_KERNEL_SANDBOX_STAGE": "r4" },
      "steps": [
        { "args": "run --quiet -A setup.ts", "output": "" },
        {
          "args": "run --quiet --allow-ffi --allow-read=. --allow-write=out --deny-write=out/keep write_deny.ts",
          "output": "write_deny.out"
        }
      ]
    },
    "auto_write_deny_report": {
      "if": "kernelSandboxEnforceLinux",
      "envs": { "DENO_INTERNAL_KERNEL_SANDBOX_STAGE": "r4" },
      "steps": [
        { "args": "run --quiet -A setup.ts", "output": "" },
        {
          "args": "run --kernel-sandbox-report --allow-read=. --allow-write=out --deny-write=out/keep exit0.ts",
          "output": "auto_report.out"
        }
      ]
    },
    // the supervisor keeps the PID the program was started with (what a
    // service manager's Type=exec watches), passes a signal sent to it on,
    // and exits with the program's status or by the program's signal
    "supervisor_keeps_pid_status_and_signals": {
      "if": "kernelSandboxEnforce",
      "args": "run --quiet -A pid_outer.ts",
      "output": "pid.out"
    },
    // as PID 1 of a PID namespace (a container's init): a SIGTERM from
    // outside reaches the program, and the supervisor exits with its code
    "supervisor_as_pid_1": {
      "if": "kernelSandboxPidNamespace",
      "args": "run --quiet -A pid1_outer.ts",
      "output": "pid1.out"
    }
  }
}
