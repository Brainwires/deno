// denext (DENEXT.md items 449, 552): --kernel-sandbox-exec=strict on Linux.
// The run list's programs start, by path, by descriptor and by their own
// /proc name; every other form of an exec call is refused for the whole
// process tree, whatever file it names. Needs a C compiler (`cc`, or $CC).
{
  "tempDir": true,
  "tests": {
    "strict_exec_call_forms": {
      "if": "kernelSandboxEnforceLinux",
      "steps": [
        { "args": "run --quiet -A setup.ts", "output": "" },
        {
          "args": "run --quiet --kernel-sandbox=enforce --kernel-sandbox-exec=strict --allow-run=sh,./bin/helper --allow-read=. main.ts",
          "output": "main.out"
        }
      ]
    },
    // the same calls without a strict scope: any readable program starts
    // (plan D3), so each form runs the other program
    "exec_call_forms_without_strict": {
      "if": "kernelSandboxEnforceLinux",
      "steps": [
        { "args": "run --quiet -A setup.ts", "output": "" },
        {
          "args": "run --quiet --kernel-sandbox=enforce --allow-run=sh,./bin/helper --allow-read=. main.ts",
          "output": "main_off.out"
        }
      ]
    }
  }
}
