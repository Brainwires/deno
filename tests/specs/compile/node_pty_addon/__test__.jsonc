{
  // node-pty whose package carries its addon (built at install here with
  // node-gyp, as `@denotest/node-addon`; the real package ships prebuilds).
  // The package's `native` export is the addon under --allow-ffi alone, in a
  // compiled program too (DENEXT.md item 268; on 3.0.0-denext.11 and .12 it
  // was null). On Unix `spawn` is the runtime's all the same, so a child's
  // output and exit arrive (item 269; from 3.0.0-denext.13 the package's own
  // `spawn` never delivered them), and `native` is null without --allow-ffi.
  // On Windows the package's own code loads (item 268).
  "tempDir": true,
  "steps": [{
    "args": "install --allow-scripts --no-jail-scripts",
    "output": "[WILDCARD]"
  }, {
    "args": "run --allow-read --allow-ffi main.ts",
    "output": "main.out"
  }, {
    "if": "unix",
    "args": "run --allow-read --allow-env --allow-run --allow-ffi spawn.ts",
    "output": "spawn.out"
  }, {
    "if": "unix",
    "args": "run --allow-read --allow-env --allow-run spawn.ts",
    "output": "spawn_no_ffi.out"
  }, {
    "args": "compile --no-check --allow-ffi --output out main.ts",
    "output": "[WILDCARD]"
  }, {
    "commandName": "./out",
    "args": [],
    "output": "main.out"
  }]
}
