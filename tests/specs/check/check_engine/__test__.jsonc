{
  "tests": {
    // denext: native TypeScript 7 by default ...
    "native": {
      "args": "check bad.ts",
      "output": "bad.out",
      "exitCode": 1
    },
    // ... the in-process TypeScript 6.0.3 with --check-engine=tsc ...
    "flag_tsc": {
      "args": "check --check-engine=tsc bad.ts",
      "output": "bad.out",
      "exitCode": 1
    },
    // ... or DENO_CHECK_ENGINE=tsc (the flag wins over it)
    "env_tsc": {
      "args": "check bad.ts",
      "envs": { "DENO_CHECK_ENGINE": "tsc" },
      "output": "bad.out",
      "exitCode": 1
    },
    "flag_wins_over_env": {
      "args": "check --check-engine=native -L debug ok.ts",
      "envs": { "DENO_CHECK_ENGINE": "tsc" },
      "output": "[WILDCARD]native tsc[WILDCARD]",
      "exitCode": 0
    },
    "env_unknown_value_warns": {
      "args": "check ok.ts",
      "envs": { "DENO_CHECK_ENGINE": "tsgo" },
      "output": "[WILDCARD]DENO_CHECK_ENGINE=tsgo: unsupported type-check engine: tsgo (expected \"native\" or \"tsc\"); type-checking natively\n[WILDCARD]",
      "exitCode": 0
    },
    "flag_unknown_value": {
      "args": "check --check-engine=tsgo ok.ts",
      "output": "[WILDCARD]tsgo[WILDCARD]",
      "exitCode": 1
    },
    // every command that type-checks takes the engine
    "test_native": {
      "args": "test -L debug bad_test.ts",
      "output": "[WILDCARD]Type checking (native tsc)[WILDCARD]TS2322 [ERROR][WILDCARD]",
      "exitCode": 1
    },
    "test_tsc": {
      "args": "test --check-engine=tsc bad_test.ts",
      "output": "Check [WILDCARD]bad_test.ts\nTS2322 [ERROR][WILDCARD]",
      "exitCode": 1
    },
    // parity: one expected output for both engines
    "test_parity_native": {
      "args": "test bad_test.ts",
      "output": "bad_test.out",
      "exitCode": 1
    },
    "test_parity_tsc": {
      "args": "test bad_test.ts",
      "envs": { "DENO_CHECK_ENGINE": "tsc" },
      "output": "bad_test.out",
      "exitCode": 1
    },
    "run_parity_native": {
      "args": "run --check bad.ts",
      "output": "bad_run.out",
      "exitCode": 1
    },
    "run_parity_tsc": {
      "args": "run --check --check-engine=tsc bad.ts",
      "output": "bad_run.out",
      "exitCode": 1
    },
    "bench_parity_native": {
      "args": "bench bad_bench.ts",
      "output": "bad_bench.out",
      "exitCode": 1
    },
    "bench_parity_tsc": {
      "args": "bench --check-engine=tsc bad_bench.ts",
      "output": "bad_bench.out",
      "exitCode": 1
    },
    "bundle_native": {
      "args": "bundle -L debug --check bad.ts",
      "output": "[WILDCARD]Type checking (native tsc)[WILDCARD]TS2322 [ERROR][WILDCARD]",
      "exitCode": 1
    },
    "bundle_parity_native": {
      "args": "bundle --check bad.ts",
      "output": "bad_bundle.out",
      "exitCode": 1
    },
    "bundle_parity_tsc": {
      "args": "bundle --check --check-engine=tsc bad.ts",
      "output": "bad_bundle.out",
      "exitCode": 1
    },
    // `deno bundle`'s own sloppy resolution keeps the native compiler
    "bundle_extensionless_native": {
      "args": "bundle -L debug --check bundle_extensionless.ts",
      "output": "[WILDCARD]Type checking (native tsc)[WILDCARD]TS2322 [ERROR][WILDCARD]",
      "exitCode": 1
    },
    "bundle_extensionless_parity_native": {
      "args": "bundle --check bundle_extensionless.ts",
      "output": "bundle_extensionless.out",
      "exitCode": 1
    },
    "bundle_extensionless_parity_tsc": {
      "args": "bundle --check --check-engine=tsc bundle_extensionless.ts",
      "output": "bundle_extensionless.out",
      "exitCode": 1
    },
    "publish_native": {
      "args": "publish -L debug --dry-run --allow-dirty",
      "cwd": "publish_bad",
      "output": "[WILDCARD]Type checking (native tsc)[WILDCARD]TS2322 [ERROR][WILDCARD]",
      "exitCode": 1
    },
    "publish_parity_native": {
      "args": "publish --dry-run --allow-dirty",
      "cwd": "publish_bad",
      "output": "publish_bad.out",
      "exitCode": 1
    },
    "publish_parity_tsc": {
      "args": "publish --dry-run --allow-dirty --check-engine=tsc",
      "cwd": "publish_bad",
      "output": "publish_bad.out",
      "exitCode": 1
    },
    // the slow-types check is Deno's own, whichever engine type-checks
    "publish_slow_types_native": {
      "args": "publish --dry-run --allow-dirty",
      "cwd": "publish_slow",
      "output": "publish_slow.out",
      "exitCode": 1
    },
    "publish_slow_types_tsc": {
      "args": "publish --dry-run --allow-dirty",
      "cwd": "publish_slow",
      "envs": { "DENO_CHECK_ENGINE": "tsc" },
      "output": "publish_slow.out",
      "exitCode": 1
    },
    "run_native": {
      "args": "run -L debug --check bad.ts",
      "output": "[WILDCARD]Type checking (native tsc)[WILDCARD]TS2322 [ERROR][WILDCARD]",
      "exitCode": 1
    },
    "bench_native": {
      "args": "bench -L debug bad_bench.ts",
      "output": "[WILDCARD]Type checking (native tsc)[WILDCARD]TS2322 [ERROR][WILDCARD]",
      "exitCode": 1
    },
    // the code blocks of --doc / --doc-only and `test --doc` are written out
    // for the native compiler
    "doc_only": {
      "args": "check --doc-only -L debug doc.ts",
      "output": "[WILDCARD]Type checking (native tsc)[WILDCARD]TS2322 [ERROR][WILDCARD]",
      "exitCode": 1
    },
    "doc_only_parity_native": {
      "args": "check --doc-only doc.ts",
      "output": "doc_only.out",
      "exitCode": 1
    },
    "doc_only_parity_tsc": {
      "args": "check --doc-only --check-engine=tsc doc.ts",
      "output": "doc_only.out",
      "exitCode": 1
    },
    "check_doc_parity_native": {
      "args": "check --doc doc.ts",
      "output": "check_doc.out",
      "exitCode": 1
    },
    "check_doc_parity_tsc": {
      "args": "check --doc doc.ts",
      "envs": { "DENO_CHECK_ENGINE": "tsc" },
      "output": "check_doc.out",
      "exitCode": 1
    },
    "test_doc_native": {
      "args": "test --doc -L debug doc.ts",
      "output": "[WILDCARD]Type checking (native tsc)[WILDCARD]TS2322 [ERROR][WILDCARD]",
      "exitCode": 1
    },
    "test_doc_parity_native": {
      "args": "test --doc doc.ts",
      "output": "test_doc.out",
      "exitCode": 1
    },
    "test_doc_parity_tsc": {
      "args": "test --doc --check-engine=tsc doc.ts",
      "output": "test_doc.out",
      "exitCode": 1
    },
    // a block's relative import and its auto-import of the documented module
    "test_doc_imports_parity_native": {
      "args": "test --doc doc_imports.ts",
      "output": "doc_imports.out",
      "exitCode": 1
    },
    "test_doc_imports_parity_tsc": {
      "args": "test --doc --check-engine=tsc doc_imports.ts",
      "output": "doc_imports.out",
      "exitCode": 1
    },
    // a graph the native compiler can't express keeps the in-process checker,
    // saying why at debug level
    "fallback_debug_record": {
      "args": "run -L debug --check fallback.ts",
      "output": "[WILDCARD]Type checking in-process: a @deno-types redirect\n[WILDCARD]TS2322 [ERROR][WILDCARD]",
      "exitCode": 1
    },
    // the vendored compiler can be overridden; a path that is not a file is an
    // error that names the variable
    "tsgo_bin_not_a_file": {
      "args": "check ok.ts",
      "envs": { "DENO_TSGO_BIN": "./no-such-tsc" },
      "output": "[WILDCARD]DENO_TSGO_BIN is set to ./no-such-tsc, which is not a file\n",
      "exitCode": 1
    }
  }
}
