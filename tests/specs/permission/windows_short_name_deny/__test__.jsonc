{
  "tempDir": true,
  "tests": {
    "short_names": {
      "if": "windows",
      "steps": [
        {
          "args": "run --allow-read --allow-write --allow-run setup.ts",
          "output": "setup done\n"
        },
        {
          "args": "run --allow-read --allow-write=base --deny-write=base/longname/b --allow-run main.ts",
          "output": "main.out"
        }
      ]
    }
  }
}
