{
  "tempDir": true,
  "tests": {
    "deno_and_node": {
      "if": "unix",
      "steps": [
        {
          "args": "run --allow-read --allow-write setup.ts",
          "output": "setup done\n"
        },
        {
          "args": "run --allow-read --allow-write=base --deny-write=base/a/b main.ts",
          "output": "main.out"
        }
      ]
    }
  }
}
