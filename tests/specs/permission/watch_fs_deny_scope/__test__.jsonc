{
  "tempDir": true,
  "tests": {
    // a recursive Deno.watchFs does not report changes inside a --deny-read
    // scope below the watched root, by its name or through a symlink
    "watch_fs": {
      "if": "unix",
      "steps": [
        {
          "args": "run --allow-read --allow-write setup.ts",
          "output": "setup done\n"
        },
        {
          "args": "run --allow-read --allow-write --deny-read=watched/secret watch.ts",
          "output": "watch.out"
        }
      ]
    },
    // the same without a symlink, on every platform (ReadDirectoryChangesW
    // on Windows)
    "watch_fs_nolink": {
      "steps": [
        {
          "args": "run --allow-read --allow-write setup.ts nolink",
          "output": "setup done\n"
        },
        {
          "args": "run --allow-read --allow-write --deny-read=watched/secret watch.ts",
          "output": "watch.out"
        }
      ]
    },
    // with no deny, a change made through a link to a directory inside the
    // watched tree is reported by its real path
    "watch_fs_link_inside_tree": {
      "if": "unix",
      "args": "run --allow-read --allow-write watch_link.ts",
      "output": "saw both changes: true\n"
    },
    "node_fs_watch": {
      "if": "unix",
      "steps": [
        {
          "args": "run --allow-read --allow-write setup.ts",
          "output": "setup done\n"
        },
        {
          "args": "run --allow-read --allow-write --deny-read=watched/secret watch_node.mjs",
          "output": "watch.out"
        }
      ]
    }
  }
}
