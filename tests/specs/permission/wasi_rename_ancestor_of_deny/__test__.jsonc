{
  "tempDir": true,
  "tests": {
    // Unix only: on Windows a path-scoped grant made from a working directory
    // with an 8.3 short name (the CI runner's RUNNER~1) never matches the long
    // canonical paths node:wasi checks, so every path_* op is refused there.
    "node_wasi": {
      "if": "unix",
      "steps": [
        {
          "args": "run --allow-read --allow-write setup.ts",
          "output": "setup done\n"
        },
        {
          "args": "run --allow-read --allow-write=base --deny-write=base/a/b,base/c/b main.ts",
          "output": "main.out"
        }
      ]
    }
  }
}
