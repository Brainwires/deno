{
  "tempDir": true,
  "envs": {
    "DENO_DIR": "$PWD/deno_dir"
  },
  "steps": [{
    // create deno dir
    "args": "run http://localhost:4545/echo.ts hi",
    "output": "[WILDCARD]"
  }, {
    "args": [
      "eval",
      "console.log(Deno.statSync('./deno_dir') != null)"
    ],
    "output": "true\n"
  }, {
    "args": "clean",
    "output": "Removed [WILDLINE]/deno_dir ([WILDCARD]files, [WILDCARD])\n"
  }, {
    "envs": {
      // use a new dir to avoid creating the old one
      "DENO_DIR": "$PWD/other"
    },
    "args": "clean",
    "output": ""
  }, {
    "envs": {
      // use a new dir to avoid creating the old one
      "DENO_DIR": "$PWD/other"
    },
    // everything is removed except the lock files, which other processes
    // may be waiting on
    "args": [
      "eval",
      "console.log(Array.from(Deno.readDirSync('./deno_dir'), (e) => e.name).join(','))"
    ],
    "output": "locks\n"
  }]
}
