  // project mode is the exploratory bed for implicit-set gaps (an unscoped
  // grant narrowed to the project): not curated yet, so it gates nothing.
  // Its first run (Linux node_compat: about 500 of 3878 fail, most of them a
  // nested deno that can't read its own /proc/self, P6) is in the item 451
  // report
  "project": {
    "specs": {},
    "node_compat": {},
    "npm_matrix": {},
    "denext_integration": {},
    "denext_e2e": {}
  },
  // The stage beds (DENEXT.md item 472): the suites at a later rollout stage
  // of `auto` (DENO_INTERNAL_KERNEL_SANDBOX_STAGE), nothing forced. Empty
  // until the first run of each is triaged: every failure is unexpected, so
  // the first run lists what a default flip would change.
  "stage-r3": {},
  // stage-r4 (denext.30 WP-D): what the R4 flip changes. Triaged on the
  // merged train before the flip commit; the soak (soak.ts, seven green full
  // runs) counts only runs of this list. An entry is one of: a test that
  // asserts unconfined behaviour (fix the test to say so itself, with
  // --kernel-sandbox=off, instead of listing it), a gap the guarantee matrix
  // documents (a context R4 leaves at warn or off: eval, stdin, repl,
  // jupyter, a non-strict desktop package), or an implicit-set entry with
  // the test that covers it. "to triage" / "to fix" fails precondition 2a.
  // Compiled programs ignore the stage variable (their mode is baked), so a
  // compiled spec's mode comes from its own --kernel-sandbox, never from
  // this bed.
  "stage-r4": {
    "specs": {
      "specs::compile::node_pty_addon": {
        "os": [
          "linux"
        ],
