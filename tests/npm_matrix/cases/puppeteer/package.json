{
  "name": "npm-matrix-puppeteer",
  "version": "1.0.0",
  "private": true,
  "dependencies": {
    "puppeteer": "^24"
  },
  "deno": {
    "supplyChain": {
      "jailScripts": {
        "packages": {
          "puppeteer": {
            "net": ["storage.googleapis.com:443"],
            "env": ["PUPPETEER_CACHE_DIR"],
            "write": [".pcache"]
          }
        }
      }
    }
  }
}
